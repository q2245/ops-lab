# ops-lab 全局变量：改端口或密码只需要动这里
LAB_HOST=127.0.0.1

# 可观测性
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
JAEGER_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# 负载均衡 / 网关
NGINX_PORT=18080
HAPROXY_STATS_PORT=8404

# 中间件
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379
MYSQL_PORT=3306
POSTGRES_PORT=5432
KAFKA_PORT=9092
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# CI/CD
GITEA_HTTP_PORT=3200
GITEA_SSH_PORT=2222

# 密码（仅用于本地学习，绝对不要照搬到生产）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
MYSQL_ROOT_PASSWORD=root123
POSTGRES_PASSWORD=postgres123
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# 日志与数据落盘目录
LAB_DATA_DIR=./data
